              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const permitId = Number(pm.collectionVariables.get('invalidPermitId'));",
                  "const match = json.find(item => Number(item.permit_id) === permitId && item.event_type === 'permits.compliance_failed');",
                  "pm.test('Compliance failure notification exists', function () {",
                  "  pm.expect(match).to.exist;",
                  "});"
                ]
              }
