    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Create Valid Permit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pipeline welding\",\n  \"description\": \"Repair welding on line 4\",\n  \"safety_measures\": \"Gas analysis, barriers, extinguishers\",\n  \"facility_id\": 1,\n  \"work_type_id\": 1,\n  \"created_by_id\": 1,\n  \"approver_employee_id\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/permits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "permits"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('permitId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Valid Permit",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/permits/{{permitId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "permits",
                "{{permitId}}",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Get Valid Permit After Workers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/permits/{{permitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "permits",
                "{{permitId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Permit moved to under_review', function () {",
                  "  pm.expect(json.status).to.eql('under_review');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Notifications For Valid Permit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const permitId = Number(pm.collectionVariables.get('permitId'));",
                  "const match = json.find(item => Number(item.permit_id) === permitId);",
                  "pm.test('Notification exists for valid permit', function () {",
                  "  pm.expect(match).to.exist;",
                  "});",
                  "if (match && match.id) {",
                  "  pm.collectionVariables.set('notificationId', match.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Notification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}"
              ]
            }
          }
        },
        {
          "name": "Approve Valid Permit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approver_employee_id\": 2,\n  \"comment\": \"All safety controls are in place\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/permits/{{permitId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "permits",
                "{{permitId}}",
                "approve"
              ]
            }
          }
        }
      ]
    },
